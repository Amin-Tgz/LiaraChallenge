{
  "healthCheck": {
    "command": [
      "/bin/wget",
      "-q",
      "-O",
      "/dev/null",
      "http://127.0.0.1:3100/ready"
    ],
    "interval": 10000,
    "timeout": 3000,
    "retries": 10,
    "startPeriod": 3000
  },
  "app": "liara-rescue-loki",
  "platform": "docker",
  "port": 3100,
  "disks": [
    {
      "name": "loki-data",
      "mountTo": "/loki"
    }
  ]
}
