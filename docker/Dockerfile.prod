# syntax=docker/dockerfile:1
FROM node:22.13.1-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12.11-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/usr/local

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project --no-dev

COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY --from=web /web/dist ./web/dist
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# The docs checkout lives inside the image's writable tree rather than at a host
# path, so DOCS_CACHE_DIR never has to name a developer's laptop.
RUN mkdir -p /app/.cache/docs

RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

EXPOSE 8000
# The probe is role-aware, so one image answers for both services: HTTP for the
# API, PID-1 identity for the worker, which listens on no port.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD /usr/local/bin/entrypoint.sh --check || exit 1

CMD ["/usr/local/bin/entrypoint.sh"]
