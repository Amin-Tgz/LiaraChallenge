# Local development only. Production values live in the Liara secrets panel.
# This file must never contain a real credential.

# --- Runtime ---
APP_ENV=local
LOG_LEVEL=INFO
WEB_DIST_DIR=web/dist

# --- Chat LLM ---
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash

# --- Bulk FAQ generation: separate var so it can diverge from chat ---
FAQ_LLM_MODEL=gemini-3.7-flash

# --- Embeddings ---
EMBEDDING_BASE_URL=https://api.avalai.ir/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
# pgvector caps HNSW indexes at 2000 dims; the model's native 3072 is unindexable.
EMBEDDING_DIMENSIONS=1536

# --- Gateway ---
PORTKEY_BASE_URL=http://portkey:8787
# Secondary provider, OpenAI-compatible. Must be reachable from a deployed container.
PORTKEY_FALLBACK_BASE_URL=
PORTKEY_FALLBACK_API_KEY=
PORTKEY_FALLBACK_MODEL=

# --- Evaluation ---
# MUST differ from LLM_MODEL — a model scoring its own output inflates every metric.
EVAL_JUDGE_MODEL=

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://rescue:rescue@postgres:5432/rescue
REDIS_URL=redis://redis:6379/0

# --- Ingestion scope: full corpus. Narrow via INGEST_SECTIONS if day 1 runs long ---
DOCS_REPO_URL=https://github.com/liara-cloud/docs
DOCS_REPO_BRANCH=master
INGEST_SECTIONS=*
INGEST_EXCLUDE_GLOBS=
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=1200
INGEST_DISCARD_RATIO_THRESHOLD=0.35
DOCS_CACHE_DIR=.cache/docs
DOCS_BASE_URL=https://docs.liara.ir
EMBEDDING_BATCH_SIZE=16
# Generous: a slow request must not be retried as though it had failed.
EMBEDDING_TIMEOUT_SECONDS=120
# At least 1, or a rollback has no prior version to return to.
INDEX_RETENTION_COUNT=2

# --- Retrieval: cosine SIMILARITY everywhere, never pgvector distance ---
FAQ_SIMILARITY_THRESHOLD=0.4
FAQ_TOP_K=5
RETRIEVAL_TOP_K=8
RETRIEVAL_SIMILARITY_THRESHOLD=0.25
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_LEXICAL_WEIGHT=1.0
INDEX_STALE_AFTER_DAYS=14

# --- Agent bounds: enforced in code, not requested in the prompt ---
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_REWRITES=2
AGENT_TOKEN_BUDGET=8000
AGENT_TIMEOUT_SECONDS=60
MAX_QUESTION_CHARS=2000
MAX_HISTORY_TURNS=20

# --- Rate limiting ---
RATE_LIMIT_PER_IP_PER_MINUTE=30
RATE_LIMIT_PER_SESSION_PER_MINUTE=15

# --- Admin (HTTP Basic over HTTPS) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Observability ---
OPIK_API_KEY=
OPIK_WORKSPACE=
