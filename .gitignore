# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
web/dist/
web/node_modules/
*.local

# Tooling / local state
.DS_Store
var/
tmp/
playwright-report/
test-results/
graphify-out/

# Docs checkout kept between ingestion runs (DOCS_CACHE_DIR). It is a clone of
# an upstream repository, so committing it would nest one git repo inside
# another and ship a corpus the pipeline re-fetches anyway.
.cache/

# Locally generated operational credentials
secrets/

# Playwright MCP session artifacts
.playwright-mcp/
